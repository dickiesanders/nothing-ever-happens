# Deployment mode (secrets and toggles only — everything else is in config.json)
BOT_MODE=paper
DRY_RUN=true
LIVE_TRADING_ENABLED=false

# --- Polymarket (venue=polymarket) ---
PRIVATE_KEY=
# Required for signature_type 1 or 2 live accounts
FUNDER_ADDRESS=
# Required for proxy-wallet approval bootstrap in live signature_type=2 mode
POLYGON_RPC_URL=

# --- Kalshi (venue=kalshi) ---
# API key ID from the Kalshi API keys dashboard
KALSHI_API_KEY_ID=
# Path to the RSA private key PEM file for that key ID
KALSHI_PRIVATE_KEY_PATH=
# Or paste the PEM contents inline (takes precedence over PATH if set)
# KALSHI_PRIVATE_KEY_PEM=

# Required for BOT_MODE=live
DATABASE_URL=

# Config file path (default: config.json)
# CONFIG_PATH=config.json
